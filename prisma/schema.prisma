generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  HR_OFFICER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_PROBATION
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  WEEKEND
  HOLIDAY
  NOT_MARKED
}

enum LeaveType {
  PAID
  SICK
  UNPAID
  CASUAL
  MATERNITY
  PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

enum OTPPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum NotificationType {
  EMAIL_VERIFIED
  ATTENDANCE_MARKED
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  SALARY_GENERATED
  PROFILE_UPDATED
  SECURITY_EVENT
  SYSTEM
}

enum DocumentType {
  OFFER_LETTER
  CONTRACT
  ID_PROOF
  ADDRESS_PROOF
  EDUCATIONAL
  EXPERIENCE
  SALARY_SLIP
  OTHER
}

model User {
  id                String           @id @default(cuid())
  employeeId        String           @unique
  email             String           @unique
  password          String
  role              UserRole         @default(EMPLOYEE)
  isEmailVerified   Boolean          @default(false)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  profile           EmployeeProfile?
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]   @relation("EmployeeLeaveRequests")
  reviewedLeaves    LeaveRequest[]   @relation("ReviewerLeaveRequests")
  leaveBalance      LeaveBalance?
  payrollRecords    PayrollRecord[]
  salaryComponent   SalaryComponent?
  documents         Document[]       @relation("EmployeeDocuments")
  uploadedDocuments Document[]       @relation("UploaderDocuments")
  notifications     Notification[]
  otpVerifications  OTPVerification[]
  auditLogs         AuditLog[]
  generatedPayrolls PayrollRecord[]  @relation("GeneratedPayrolls")

  @@index([email])
  @@index([employeeId])
  @@map("users")
}

model EmployeeProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  firstName          String
  lastName           String
  phone              String?
  dateOfBirth        DateTime?
  gender             String?
  address            String?
  emergencyContact   String?
  avatar             String?
  departmentId       String?
  designationId      String?
  joiningDate        DateTime?
  employmentType     EmploymentType   @default(FULL_TIME)
  reportingManagerId String?
  status             EmployeeStatus   @default(ACTIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       Department?      @relation(fields: [departmentId], references: [id])
  designation      Designation?     @relation(fields: [designationId], references: [id])
  reportingManager EmployeeProfile? @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates     EmployeeProfile[] @relation("ReportingManager")

  @@map("employee_profiles")
}

model Department {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  employees   EmployeeProfile[]

  @@map("departments")
}

model Designation {
  id          String            @id @default(cuid())
  name        String
  level       Int               @default(1)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  employees   EmployeeProfile[]

  @@map("designations")
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  userId       String
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  workingHours Float?
  status       AttendanceStatus @default(NOT_MARKED)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("attendance_records")
}

model LeaveRequest {
  id            String      @id @default(cuid())
  userId        String
  leaveType     LeaveType   @default(PAID)
  startDate     DateTime
  endDate       DateTime
  totalDays     Int
  reason        String
  attachment    String?
  status        LeaveStatus @default(PENDING)
  reviewedById  String?
  reviewComment String?
  reviewedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user       User  @relation("EmployeeLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewerLeaveRequests", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("leave_requests")
}

model LeaveBalance {
  id          String   @id @default(cuid())
  userId      String   @unique
  paidLeave   Int      @default(12)
  sickLeave   Int      @default(8)
  unpaidLeave Int      @default(0)
  casualLeave Int      @default(6)
  year        Int      @default(2025)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leave_balances")
}

model SalaryComponent {
  id            String   @id @default(cuid())
  userId        String   @unique
  basicSalary   Float    @default(0)
  hra           Float    @default(0)
  allowances    Float    @default(0)
  pf            Float    @default(0)
  deductions    Float    @default(0)
  grossSalary   Float    @default(0)
  netSalary     Float    @default(0)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("salary_components")
}

model PayrollRecord {
  id            String        @id @default(cuid())
  userId        String
  month         Int
  year          Int
  basicSalary   Float
  hra           Float
  allowances    Float
  pf            Float
  deductions    Float
  grossSalary   Float
  netSalary     Float
  workingDays   Int           @default(26)
  presentDays   Int           @default(26)
  status        PayrollStatus @default(DRAFT)
  generatedById String?
  generatedAt   DateTime      @default(now())
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedBy User?       @relation("GeneratedPayrolls", fields: [generatedById], references: [id])
  salarySlip  SalarySlip?

  @@unique([userId, month, year])
  @@index([userId])
  @@map("payroll_records")
}

model SalarySlip {
  id          String        @id @default(cuid())
  payrollId   String        @unique
  userId      String
  slipData    Json
  generatedAt DateTime      @default(now())

  payroll PayrollRecord @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@map("salary_slips")
}

model Document {
  id           String       @id @default(cuid())
  userId       String
  name         String
  type         DocumentType @default(OTHER)
  url          String
  uploadedById String
  isPublic     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user       User @relation("EmployeeDocuments", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("UploaderDocuments", fields: [uploadedById], references: [id])

  @@index([userId])
  @@map("documents")
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  title             String
  message           String
  type              NotificationType @default(SYSTEM)
  isRead            Boolean          @default(false)
  relatedEntityId   String?
  relatedEntityType String?
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model OTPVerification {
  id        String     @id @default(cuid())
  email     String
  otpHash   String
  purpose   OTPPurpose
  expiresAt DateTime
  attempts  Int        @default(0)
  isUsed    Boolean    @default(false)
  createdAt DateTime   @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@map("otp_verifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType])
  @@map("audit_logs")
}

model CompanySetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("company_settings")
}
